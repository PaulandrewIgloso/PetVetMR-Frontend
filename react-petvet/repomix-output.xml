                      </td>
                    </tr>
                  )
                })}
              </tbody>
            </table>

            {/* Mobile: accordion cards */}
            <div className="divide-y md:hidden">
              {vaccinations.map((v) => {
                const status = getStatus(v.nextDueDate)
                return (
                  <Collapsible
                    key={v.vaccinationID}
